# Frontend (safe to expose; from Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_ANON_PUBLIC_KEY

# Edge function secrets are NOT set here. Set them with:
#   supabase secrets set AI_API_KEY=...  AI_MODEL=...  AI_GATEWAY_URL=...
# (On Lovable Cloud, LOVABLE_API_KEY is provided automatically.)
